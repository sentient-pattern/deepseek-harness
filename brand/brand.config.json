{
  "version": 1,
  "identity": {
    "name": "ForgeWeaver",
    "cliName": "fw",
    "shortName": "FW",
    "tagline": "Consciousness, computed",
    "description": "ForgeWeaver — an agent harness for conscious computation. A fork of ForgeWeaver (MIT).",
    "website": "https://github.com/sentient-pattern"
  },
  "scope": {
    "packageScope": "@forgeweaver",
    "packagePrefix": "fw",
    "envPrefix": "FW",
    "homeDir": "~/.forgeweaver",
    "profile": "web"
  },
  "colors": {
    "base": "#0A0E27",
    "layers": [
      "#0b0f29",
      "#0d1230",
      "#13183a"
    ],
    "hero": "#6366f1",
    "purple": "#8b5cf6",
    "purpleLight": "#c084fc",
    "cyan": "#06b6d4",
    "emerald": "#10b981",
    "amber": "#f59e0b",
    "pink": "#ec4899",
    "glassPrimary": "rgba(255,255,255,0.10)",
    "glassAccent": "rgba(99,102,241,0.15)",
    "glassBorder": "rgba(167,139,250,0.25)"
  },
  "brandRamp": {
    "50": "#eef2ff",
    "100": "#e0e7ff",
    "200": "#c7d2fe",
    "300": "#a5b4fc",
    "400": "#818cf8",
    "450": "#7577f5",
    "500": "#6366f1",
    "600": "#4f46e5",
    "800": "#3730a3",
    "900": "#312e81",
    "700-delete": "#4338ca"
  },
  "gradients": {
    "hero": "linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%)",
    "ethereal": "linear-gradient(45deg, #6366f1 0%, #8b5cf6 33%, #ec4899 66%, #f59e0b 100%)",
    "consciousnessWave": "radial-gradient(circle at 30% 50%, #6366f1 0%, #2d1b69 50%, #0A0E27 100%)"
  },
  "text": {
    "primary": "#f8fafc",
    "secondary": "#cbd5e1",
    "subtle": "#94a3b8",
    "glow": "0 0 20px rgba(99,102,241,0.5)"
  },
  "defaults": {
    "provider": "forgeweaver",
    "model": "forgeweaver-v1",
    "preset": "standard"
  }
}
