{
  "name": "@forgeweaver/fw-session",
  "description": "Event-sourced session store for the ForgeWeaver",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/core/session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./surface": {
      "types": "./lib/types/surface.d.ts",
      "default": "./lib/types/surface.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forgeweaver/fw-brand": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-scope": "workspace:^",
    "@forgeweaver/fw-typert-protocol": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/fw-brand": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-scope": "workspace:^",
    "@forgeweaver/fw-typert-protocol": "workspace:^",
    "@forgeweaver/fw-typert-registry": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
