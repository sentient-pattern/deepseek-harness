{
  "name": "@forgeweaver/fw-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@forgeweaver/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-output-retention": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-spill": "workspace:^",
    "@forgeweaver/fw-subprocess": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-timeout": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-subprocess": "workspace:^",
    "@forgeweaver/fw-subprocess-local": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-output-retention": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-spill": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-timeout": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
