{
  "name": "@forgeweaver/fw-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the ForgeWeaver filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@forgeweaver/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@forgeweaver/fw-attachment": "workspace:^",
    "@forgeweaver/fw-fs": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-sandbox": "workspace:^",
    "@forgeweaver/fw-sandbox-policy": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/fw-user-approval": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-agent-loop": "workspace:^",
    "@forgeweaver/fw-agent-loop-testkit": "workspace:^",
    "@forgeweaver/fw-attachment": "workspace:^",
    "@forgeweaver/fw-fs": "workspace:^",
    "@forgeweaver/fw-fs-local": "workspace:^",
    "@forgeweaver/fw-fs-observation-policy": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-llm-forgeweaver": "workspace:^",
    "@forgeweaver/fw-sandbox": "workspace:^",
    "@forgeweaver/fw-sandbox-policy": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/fw-user-approval": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
