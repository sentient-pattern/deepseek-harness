{
  "name": "@forgeweaver/fw-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@forgeweaver/fw-attachment": "workspace:^",
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-agent-default-model": "workspace:^",
    "@forgeweaver/fw-api-remotes": "workspace:^",
    "@forgeweaver/fw-brand": "workspace:^",
    "@forgeweaver/fw-commands": "workspace:^",
    "@forgeweaver/fw-credentials": "workspace:^",
    "@forgeweaver/fw-goal": "workspace:^",
    "@forgeweaver/fw-host-directory-picker": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-native-command": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-session-persistence": "workspace:^",
    "@forgeweaver/fw-session-projection": "workspace:^",
    "@forgeweaver/fw-session-projection-cache": "workspace:^",
    "@forgeweaver/fw-session-query": "workspace:^",
    "@forgeweaver/fw-session-title": "workspace:^",
    "@forgeweaver/fw-settings": "workspace:^",
    "@forgeweaver/fw-skill": "workspace:^",
    "@forgeweaver/fw-subagent": "workspace:^",
    "@forgeweaver/fw-jobs": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/fw-user-approval": "workspace:^",
    "@forgeweaver/fw-user-questions": "workspace:^",
    "@forgeweaver/fw-workspace": "workspace:^",
    "@forgeweaver/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@forgeweaver/cordis": "workspace:^",
    "@forgeweaver/fw-agent-presets": "workspace:^",
    "@forgeweaver/fw-cordis-host-runner": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/cordis": "workspace:^",
    "@forgeweaver/fw-agent-presets": "workspace:^",
    "@forgeweaver/fw-cordis-host-runner": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-storage": "workspace:^",
    "@forgeweaver/fw-storage-domain": "workspace:^",
    "@forgeweaver/fw-typert-protocol": "workspace:^",
    "@forgeweaver/fw-typert-registry": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
