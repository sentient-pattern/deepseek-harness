{
  "name": "@forgeweaver/fw-schedule",
  "description": "Agent-scoped durable after, at, and fixed-rate reminders over the session event log",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-brand": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-session-persistence": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/cordis-plugin-loader": "workspace:^",
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-agent-loop": "workspace:^",
    "@forgeweaver/fw-agent-loop-testkit": "workspace:^",
    "@forgeweaver/fw-brand": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-session-persistence": "workspace:^",
    "@forgeweaver/fw-session-persistence-jsonl": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
