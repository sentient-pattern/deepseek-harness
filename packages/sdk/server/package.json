{
  "name": "@forgeweaver/fw-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process ForgeWeaver SDK clients",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@forgeweaver/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-llm-forgeweaver": "workspace:^",
    "@forgeweaver/fw-scope": "workspace:^",
    "@forgeweaver/fw-sdk-protocol": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-subagent": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/cordis-plugin-loader": "workspace:^",
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-agent-spine-demo": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-llm-forgeweaver": "workspace:^",
    "@forgeweaver/fw-scope": "workspace:^",
    "@forgeweaver/fw-sdk-protocol": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-session-persistence-jsonl": "workspace:^",
    "@forgeweaver/fw-subagent": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
