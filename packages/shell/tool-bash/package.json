{
  "name": "@forgeweaver/fw-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-shell": "workspace:^",
    "@forgeweaver/fw-shell-env": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-sandbox": "workspace:^",
    "@forgeweaver/fw-sandbox-policy": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-jobs": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/fw-user-approval": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "dependencies": {
    "@forgeweaver/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-agent-loop": "workspace:^",
    "@forgeweaver/fw-agent-loop-testkit": "workspace:^",
    "@forgeweaver/fw-shell": "workspace:^",
    "@forgeweaver/fw-shell-env": "workspace:^",
    "@forgeweaver/fw-bash-local": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-subprocess-local": "workspace:^",
    "@forgeweaver/fw-sandbox": "workspace:^",
    "@forgeweaver/fw-sandbox-policy": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-session-persistence-jsonl": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-jobs": "workspace:^",
    "@forgeweaver/fw-jobs-local": "workspace:^",
    "@forgeweaver/fw-tool-jobs": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/fw-user-approval": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
