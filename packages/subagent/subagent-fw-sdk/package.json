{
  "name": "@forgeweaver/fw-subagent-fw-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child ForgeWeaver runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/subagent/subagent-fw-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-sdk-client": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-subagent": "workspace:^",
    "@forgeweaver/fw-subprocess": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "dependencies": {
    "@forgeweaver/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/cordis-plugin-loader": "workspace:^",
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-loader-smoke": "workspace:^",
    "@forgeweaver/fw-sdk-client": "workspace:^",
    "@forgeweaver/fw-sdk-protocol": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-subagent": "workspace:^",
    "@forgeweaver/fw-subprocess": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
