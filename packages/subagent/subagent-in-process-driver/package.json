{
  "name": "@forgeweaver/fw-subagent-in-process-driver",
  "description": "Shared in-process subagent run driver: drives a child agent on ctx.agents (used by the spawn and fork backends)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentient-pattern/deepseek-harness.git",
    "directory": "packages/subagent/subagent-in-process-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-subagent": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  },
  "devDependencies": {
    "@forgeweaver/cordis-plugin-include": "workspace:^",
    "@forgeweaver/cordis-plugin-loader": "workspace:^",
    "@forgeweaver/fw-agent": "workspace:^",
    "@forgeweaver/fw-agent-loop": "workspace:^",
    "@forgeweaver/fw-agent-loop-testkit": "workspace:^",
    "@forgeweaver/fw-agent-presets": "workspace:^",
    "@forgeweaver/fw-fs-sandbox": "workspace:^",
    "@forgeweaver/fw-invariants": "workspace:^",
    "@forgeweaver/fw-llm": "workspace:^",
    "@forgeweaver/fw-sandbox-policy": "workspace:^",
    "@forgeweaver/fw-session": "workspace:^",
    "@forgeweaver/fw-subagent": "workspace:^",
    "@forgeweaver/fw-system-prompt": "workspace:^",
    "@forgeweaver/fw-tool-fs": "workspace:^",
    "@forgeweaver/fw-tools": "workspace:^",
    "@forgeweaver/fw-user-approval": "workspace:^",
    "@forgeweaver/cordis": "workspace:^"
  }
}
